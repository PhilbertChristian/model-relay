#!/usr/bin/env python3
"""Fake `claude` CLI for tests/test_lanes_local.py: replays a canned `-p --output-format stream-json` run.

Reads only its argv and env. Writes only into its cwd (the lane's worktree) and to $FAKE_LANE_DUMP /
$FAKE_PIDS. No network, no home directory.
FAKE_SCENARIO: success (default) | blocked | rateword | orphan | limit | ratelimit | crash | slow
"""
import json
import os
import subprocess
import sys
import time

SCENARIO = os.environ.get("FAKE_SCENARIO", "success")
CWD = os.getcwd()
MODEL = "claude-sonnet-5"
FAKE_KEY = "sk-ant-" + "api03-" + "x" * 24            # assembled at runtime; must come back redacted
FINAL = {"success": "Fixed empty-input handling in parse(); tests pass.",
         "blocked": "BLOCKED: need the Stripe test key to run the payment tests.",
         "rateword": "Added rate_limit middleware and documented the usage limit headers.",
         "orphan": "Fixed the bug; the dev server is still running."}
U = [{"input_tokens": 10, "cache_creation_input_tokens": 2000, "cache_read_input_tokens": 0, "output_tokens": 5},
     {"input_tokens": 5, "cache_creation_input_tokens": 300, "cache_read_input_tokens": 2000, "output_tokens": 120},
     {"input_tokens": 5, "cache_creation_input_tokens": 100, "cache_read_input_tokens": 2300, "output_tokens": 40},
     {"input_tokens": 3, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 2400, "output_tokens": 30}]
TOTAL = {k: sum(u[k] for u in U) for k in U[0]}


def out(obj):
    print(obj if isinstance(obj, str) else json.dumps(obj), flush=True)


def assistant(mid, block, usage, model=MODEL):
    out({"type": "assistant", "session_id": "fake", "parent_tool_use_id": None,
         "message": {"id": mid, "type": "message", "role": "assistant", "model": model, "content": [block],
                     "stop_reason": None, "usage": usage}})


if os.environ.get("FAKE_LANE_DUMP"):
    with open(os.environ["FAKE_LANE_DUMP"], "w") as f:      # env *names* only: values never leave the process
        json.dump({"argv": sys.argv[1:], "env": sorted(os.environ), "home": os.environ.get("HOME"),
                   "path": os.environ.get("PATH"), "cwd": CWD}, f)

out({"type": "system", "subtype": "init", "cwd": CWD, "session_id": "fake", "model": MODEL,
     "permissionMode": "acceptEdits", "tools": ["Read", "Edit", "Bash"]})

if SCENARIO == "slow":                                       # hangs, with a child in the same process group
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    with open(os.environ["FAKE_PIDS"], "w") as f:
        json.dump([os.getpid(), child.pid], f)
    time.sleep(60)
    sys.exit(0)
if SCENARIO == "crash":
    out("Loading session...")
    print("Error: fake claude exploded (token=" + "gh" + "p_" + "Z" * 36 + ")", file=sys.stderr)
    sys.exit(3)
if SCENARIO == "limit":
    text = "Claude AI usage limit reached|1893456000"
    assistant("msg_limit", {"type": "text", "text": text}, {"input_tokens": 0, "output_tokens": 0}, "<synthetic>")
    out({"type": "result", "subtype": "success", "is_error": True, "result": text, "total_cost_usd": 0,
         "usage": {"input_tokens": 0, "output_tokens": 0}})
    sys.exit(1)
if SCENARIO == "ratelimit":
    print('API Error: 429 {"type":"error","error":{"type":"rate_limit_error",'
          '"message":"Number of requests has exceeded your rate limit"}}', file=sys.stderr)
    out({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "",
         "total_cost_usd": 0.001, "usage": U[0]})
    sys.exit(1)

if SCENARIO == "orphan":                                     # leaves a child behind that holds our stdout open
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    with open(os.environ["FAKE_PIDS"], "w") as f:
        json.dump([child.pid], f)

# success / blocked / rateword / orphan: a small run that edits a file in the worktree
out({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed_warning", "rateLimitType": "five_hour",
                                                     "utilization": 0.91, "resetsAt": 1893456000}})
out("a stray non-JSON line")
assistant("msg_1", {"type": "text", "text": "Let me look at the parser."}, U[0])
assistant("msg_1", {"type": "tool_use", "id": "t1", "name": "Read",           # same API message: same usage again
                    "input": {"file_path": os.path.join(CWD, "src", "parse.py")}}, U[0])
out({"type": "user", "message": {"role": "user", "content": [
    {"type": "tool_result", "tool_use_id": "t1", "content": "def parse(s): ..."}]}})
assistant("msg_2", {"type": "tool_use", "id": "t2", "name": "Edit", "input": {
    "file_path": os.path.join(CWD, "src", "parse.py"), "old_string": "a", "new_string": "b"}}, U[1])
with open(os.path.join(CWD, "fake_claude_edit.txt"), "w") as f:
    f.write("edited by the fake claude\n")
assistant("msg_3", {"type": "tool_use", "id": "t3", "name": "Bash",
                    "input": {"command": "python3 -m unittest  # key " + FAKE_KEY}}, U[2])
assistant("msg_4", {"type": "text", "text": FINAL[SCENARIO]}, U[3])
out({"type": "result", "subtype": "success", "is_error": False, "num_turns": 4, "result": FINAL[SCENARIO],
     "total_cost_usd": 0.0421, "usage": TOTAL,
     "modelUsage": {MODEL: {"inputTokens": TOTAL["input_tokens"], "outputTokens": TOTAL["output_tokens"],
                            "cacheReadInputTokens": TOTAL["cache_read_input_tokens"],
                            "cacheCreationInputTokens": TOTAL["cache_creation_input_tokens"], "costUSD": 0.0421}}})
