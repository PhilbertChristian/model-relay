#!/usr/bin/env python3
"""Fake `codex` CLI for tests/test_lanes_local.py: replays a canned `codex exec --json` run.

Reads only its argv and env. Writes only into its cwd (the lane's worktree) and to $FAKE_LANE_DUMP /
$FAKE_PIDS. No network, no home directory.
FAKE_SCENARIO: success (default) | blocked | limit | crash | slow | legacy (the older {"msg": {...}} events)
"""
import json
import os
import subprocess
import sys
import time

SCENARIO = os.environ.get("FAKE_SCENARIO", "success")
CWD = os.getcwd()
FINAL = {"success": "Fixed parse() for empty input; tests pass.",
         "blocked": "BLOCKED: needs a product decision on the retry policy."}


def out(obj):
    print(obj if isinstance(obj, str) else json.dumps(obj), flush=True)


def item(kind, n, item_type, **fields):
    out({"type": kind, "item": {"id": f"item_{n}", "type": item_type, **fields}})


def edit():
    with open(os.path.join(CWD, "fake_codex_edit.txt"), "w") as f:
        f.write("edited by the fake codex\n")


if os.environ.get("FAKE_LANE_DUMP"):
    with open(os.environ["FAKE_LANE_DUMP"], "w") as f:      # env *names* only: values never leave the process
        json.dump({"argv": sys.argv[1:], "env": sorted(os.environ), "home": os.environ.get("HOME"),
                   "path": os.environ.get("PATH"), "cwd": CWD}, f)

if SCENARIO == "slow":                                       # hangs, with a child in the same process group
    out({"type": "thread.started", "thread_id": "fake"})
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    with open(os.environ["FAKE_PIDS"], "w") as f:
        json.dump([os.getpid(), child.pid], f)
    time.sleep(60)
    sys.exit(0)
if SCENARIO == "crash":
    out({"type": "thread.started", "thread_id": "fake"})
    print("thread 'main' panicked at exec/src/lib.rs:42:9: token=" + "gh" + "p_" + "Z" * 36, file=sys.stderr)
    sys.exit(101)
if SCENARIO == "legacy":
    out({"id": "0", "msg": {"type": "task_started", "model_context_window": 272000}})
    out({"id": "0", "msg": {"type": "agent_reasoning", "text": "**Looking for the failing test**"}})
    out({"id": "0", "msg": {"type": "exec_command_begin", "call_id": "c1", "command": ["bash", "-lc", "pytest -q"],
                            "cwd": CWD}})
    out({"id": "0", "msg": {"type": "token_count", "info": {"total_token_usage": {
        "input_tokens": 5000, "cached_input_tokens": 4000, "output_tokens": 300, "total_tokens": 5300}},
        "rate_limits": {"primary": {"used_percent": 42.0, "window_minutes": 300, "resets_in_seconds": 3600}}}})
    out({"id": "0", "msg": {"type": "patch_apply_begin", "call_id": "p1",
                            "changes": {os.path.join(CWD, "tests", "test_parse.py"): {"add": {"content": "..."}}}}})
    edit()
    out({"id": "0", "msg": {"type": "agent_message", "message": "Done: added tests for parse()."}})
    out({"id": "0", "msg": {"type": "token_count", "info": {"total_token_usage": {
        "input_tokens": 9000, "cached_input_tokens": 8000, "output_tokens": 700, "total_tokens": 9700}}}})
    out({"id": "0", "msg": {"type": "task_complete", "last_agent_message": "Done: added tests for parse()."}})
    sys.exit(0)

out({"type": "thread.started", "thread_id": "fake"})
out({"type": "turn.started"})
if SCENARIO == "limit":
    msg = ("You've hit your usage limit. Upgrade to Pro (https://openai.com/chatgpt/pricing) "
           "or try again in 2 hours 5 minutes.")
    out({"type": "error", "message": msg})
    out({"type": "turn.failed", "error": {"message": msg}})
    sys.exit(1)

# success / blocked
item("item.completed", 0, "reasoning", text="**Scanning the parser**")
cmd = "bash -lc 'rg -n TODO src'"
item("item.started", 1, "command_execution", command=cmd, aggregated_output="", exit_code=None, status="in_progress")
item("item.completed", 1, "command_execution", command=cmd, aggregated_output="src/parse.py:2:# TODO", exit_code=0,
     status="completed")
out({"type": "error", "message": "Reconnecting... 1/5"})    # a retried hiccup: the turn still completes
edit()
item("item.completed", 2, "file_change", changes=[{"path": os.path.join(CWD, "src", "parse.py"), "kind": "update"}],
     status="completed")
item("item.completed", 3, "agent_message", text=FINAL[SCENARIO])
out({"type": "turn.completed", "usage": {"input_tokens": 24763, "cached_input_tokens": 24448, "output_tokens": 1220}})
